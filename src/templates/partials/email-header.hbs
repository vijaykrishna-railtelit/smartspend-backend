<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{{subject}}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #F4F6F9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 15px;
      line-height: 1.6;
      color: #1a1a2e;
      -webkit-text-size-adjust: 100%;
    }
    .wrapper {
      background-color: #F4F6F9;
      padding: 32px 16px 48px;
    }
    .card {
      background: #ffffff;
      max-width: 560px;
      margin: 0 auto;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    /* ── Header ── */
    .header {
      background: #1e2a78;
      padding: 20px 32px;
      display: flex;
      align-items: center;
    }
    .logo {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.3px;
    }
    .logo span { color: #FFD600; }

    /* ── Accent line ── */
    .accent { height: 3px; background: linear-gradient(90deg, #FFD600, #FF8C00); }

    /* ── Body ── */
    .body { padding: 36px 32px 32px; }

    /* ── Footer ── */
    .footer {
      border-top: 1px solid #EAECF0;
      padding: 20px 32px;
      text-align: center;
    }
    .footer p {
      font-size: 11px;
      color: #9CA3AF;
      line-height: 1.7;
      margin: 0;
    }
    .footer a { color: #9CA3AF; text-decoration: none; }
    .footer a:hover { text-decoration: underline; }

    /* ── Typography ── */
    h1 {
      font-size: 22px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 12px;
      letter-spacing: -0.4px;
    }
    p { color: #4B5563; font-size: 15px; line-height: 1.7; margin-bottom: 16px; }
    strong { color: #111827; }

    /* ── Button ── */
    .btn {
      display: inline-block;
      background: #1e2a78;
      color: #ffffff !important;
      font-size: 14px;
      font-weight: 600;
      padding: 12px 28px;
      border-radius: 6px;
      text-decoration: none;
      letter-spacing: 0.2px;
    }

    /* ── Alert boxes ── */
    .alert-warn {
      background: #FFFBEB;
      border-left: 3px solid #F59E0B;
      border-radius: 0 6px 6px 0;
      padding: 12px 16px;
      margin: 20px 0;
    }
    .alert-warn p { font-size: 13px; color: #78350F; margin: 0; }

    .alert-danger {
      background: #FEF2F2;
      border-left: 3px solid #EF4444;
      border-radius: 0 6px 6px 0;
      padding: 12px 16px;
      margin: 20px 0;
    }
    .alert-danger p { font-size: 13px; color: #991B1B; margin: 0; }

    .alert-success {
      background: #F0FDF4;
      border-left: 3px solid #22C55E;
      border-radius: 0 6px 6px 0;
      padding: 12px 16px;
      margin: 20px 0;
    }
    .alert-success p { font-size: 13px; color: #14532D; margin: 0; }

    /* ── OTP box ── */
    .otp-box {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
      padding: 24px;
      text-align: center;
      margin: 24px 0;
    }
    .otp-label {
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #9CA3AF;
      margin-bottom: 10px;
    }
    .otp-code {
      font-size: 40px;
      font-weight: 800;
      letter-spacing: 10px;
      color: #1e2a78;
      font-family: 'Courier New', monospace;
    }

    /* ── Divider ── */
    .divider {
      border: none;
      border-top: 1px solid #F3F4F6;
      margin: 24px 0;
    }

    @media only screen and (max-width: 600px) {
      .body, .header, .footer { padding-left: 20px; padding-right: 20px; }
      .otp-code { font-size: 32px; letter-spacing: 6px; }
    }
  </style>
</head>
<body>
<div class="wrapper">
  <div class="card">

    <!-- Header -->
    <div class="header">
      <span class="logo">Smart<span>Spend</span></span>
    </div>
    <div class="accent"></div>

    <!-- Body -->
    <div class="body">
